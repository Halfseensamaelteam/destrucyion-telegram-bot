# --- Application ---
APP_ENV=development
APP_SECRET_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/destrucyion

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Telegram API (from https://my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Telegram Bot (from @BotFather) ---
BOT_TOKEN=

# --- Session encryption (Telethon sessions are encrypted with this key) ---
SESSION_ENCRYPTION_KEY=

# --- Webhook security (for the Telegram Bot webhook on Vercel) ---
WEBHOOK_SECRET=

# --- Optional ---
LOG_LEVEL=INFO
SENTRY_DSN=

# Never commit a filled-in .env file.
